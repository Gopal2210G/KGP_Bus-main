# ====================================================
# SERVER & ENVIRONMENT CONFIGURATION
# ====================================================
NODE_ENV=development
PORT=5000

# ====================================================
# CORS & ALLOWED ORIGINS (Comma-separated list of domains)
# Supports Vercel, Netlify, Render, Railway, AWS, and Localhost
# ====================================================
ALLOWED_ORIGINS=http://localhost:3000,https://kgp-bus-frontend.vercel.app

# ====================================================
# AUTHENTICATION & JWT SECURITY CONFIGURATION
# ====================================================
JWT_SECRET=YourSuperSecretJWTKeyHere
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90
SESSION_SECRET=YourSessionSecretKeyHere

# ====================================================
# POSTGRESQL DATABASE CONFIGURATION
# ====================================================
DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_SSL=true

# ====================================================
# REDIS CACHE CONFIGURATION (Optional)
# ====================================================
REDIS_URL=rediss://default:password@host:6379
